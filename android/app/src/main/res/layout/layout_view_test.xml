<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#120501"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Item"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_gravity="center"/>

        <!-- Name -->
        <AutoCompleteTextView
            android:id="@+id/nameAutoComplete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="40dp"
            android:padding="10dp"
            android:textSize="14sp"
            android:background="@drawable/material_input_bg"
            android:completionThreshold="1"
            android:hint="Name"
            android:inputType="textCapSentences"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"/>

        <!-- Category Buttons -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/catFood"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:textSize="11sp"
                        android:layout_marginEnd="6dp"
    android:background="@drawable/category_chip"
    android:textColor="#FFFFFF"
                    android:text="Food"/>

                <Button
                    android:id="@+id/catShopping"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:textSize="11sp"
                        android:layout_marginEnd="6dp"
    android:background="@drawable/category_chip"
    android:textColor="#FFFFFF"
                    android:text="Shopping"/>

                <Button
                    android:id="@+id/catLifestyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:textSize="11sp"
                        android:layout_marginEnd="6dp"
    android:background="@drawable/category_chip"
    android:textColor="#FFFFFF"
                    android:text="Lifestyle"/>

                <Button
                    android:id="@+id/catLoans"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:textSize="11sp"
                        android:layout_marginEnd="6dp"
    android:background="@drawable/category_chip"
    android:textColor="#FFFFFF"
                    android:text="Loans"/>

                <Button
                    android:id="@+id/catUtilities"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:textSize="11sp"
                        android:layout_marginEnd="6dp"
    android:background="@drawable/category_chip"
    android:textColor="#FFFFFF"
                    android:text="Utilities"/>

                <Button
                    android:id="@+id/catOther"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:textSize="11sp"
                        android:layout_marginEnd="6dp"
    android:background="@drawable/category_chip"
    android:textColor="#FFFFFF"
                    android:text="Other"/>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Quantity & Price -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/quantityEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:minHeight="40dp"
                android:padding="10dp"
                android:textSize="14sp"
                android:background="@drawable/material_input_bg"
                android:hint="Quantity"
                android:inputType="number"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"/>

            <EditText
                android:id="@+id/priceEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="40dp"
                android:padding="10dp"
                android:textSize="14sp"
                android:background="@drawable/material_input_bg"
                android:hint="Price"
                android:inputType="numberDecimal"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"/>

        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/cancelBtn"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:textSize="13sp"
                android:background="@drawable/material_input_bg"
                android:text="Cancel"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="10dp"/>

            <Button
                android:id="@+id/addSaveBtn"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:textSize="13sp"
                android:background="@drawable/material_input_bg"
                android:text="Add"
                android:textColor="#FFFFFF"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>